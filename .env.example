APP_NAME=FriendlyEats FastAPI
ENVIRONMENT=local
FIREBASE_PROJECT_ID=friendlyeats-dev

# Sprint 1 trabaja contra el emulador local de Firestore:
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

